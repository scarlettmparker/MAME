scalar JSON
scalar Long

type PagedAccounts {
  items: [Account!]!
  pageInfo: PageInfo!
}

type Account {
  id: String!
  username: String!
  personId: ID!
  status: AccountStatus!
  provider: String
  remoteUsers: [RemoteUser!]
  createdAt: DateTime
  updatedAt: DateTime
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

type IpWhitelistEntry {
  id: ID!
  pattern: String!
  description: String
  enabled: Boolean!
  immutable: Boolean!
  createdAt: DateTime
  updatedAt: DateTime
}

input IpWhitelistEntryInput {
  pattern: String!
  description: String
  immutable: Boolean
  enabled: Boolean
}

enum DeviceStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

type TailscaleDevice {
  id: ID!
  headscaleId: Long!
  name: String!
  ipv4: String
  status: DeviceStatus!
  online: Boolean!
  expiredAt: DateTime
  lastSeen: String
  createdAt: DateTime
  updatedAt: DateTime
}

type GaiaQueries {
  propertySet(ownerKey: String!, name: String!, entry: String): JSON
  myRoles: [String!]!
  account(id: ID!): Account
  accounts(pagination: PaginationInput): PagedAccounts!
  ipWhitelistEntries: [IpWhitelistEntry!]!
  tailscaleDevices: [TailscaleDevice!]!
  tailscaleDevice(id: ID!): TailscaleDevice
}

input LoginInput {
  username: String!
  password: String!
}

type AuthResult {
  token: String!
  accountId: ID!
  personId: ID!
}

type GaiaMutations {
  login(input: LoginInput!): AuthResult
  suspendAccount(id: ID!): QueryResult
  unsuspendAccount(id: ID!): QueryResult
  createIpWhitelistEntry(input: IpWhitelistEntryInput!): QueryResult
  updateIpWhitelistEntry(id: ID!, input: IpWhitelistEntryInput!): QueryResult
  deleteIpWhitelistEntry(id: ID!): QueryResult
  expireTailscaleDevice(id: ID!): QueryResult
}

extend type Query {
  gaiaQueries: GaiaQueries!
}

extend type Mutation {
  gaiaMutations: GaiaMutations!
}
