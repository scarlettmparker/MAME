{
  "name": "emulator",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --hot --preload ./css-plugin.ts server.js",
    "build": "bun run build:client && bun run build:server",
    "postbuild": "command -v sun-notify >/dev/null 2>&1 && sun-notify mame || true",
    "build:client": "bunx vite build --ssrManifest --outDir dist/client",
    "build:server": "bunx vite build --ssr src/entry-server.tsx --outDir dist/server",
    "graphql:generate": "bunx graphql-codegen --config codegen.ts",
    "lint": "bunx eslint",
    "pretty": "bunx prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json}\"",
    "preview": "NODE_ENV=production bun --preload ./css-plugin.ts server.js",
    "test": "bunx vitest run --passWithNoTests",
    "test:watch": "bunx vitest",
    "test:coverage": "bunx vitest run --coverage --passWithNoTests"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@graphql-codegen/cli": "6.0.1",
    "@graphql-codegen/client-preset": "5.1.1",
    "@graphql-codegen/typescript": "^5.0.2",
    "@graphql-codegen/typescript-operations": "^5.0.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.8.0",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/coverage-v8": "^3.2.4",
    "baseline-browser-mapping": "^2.9.11",
    "bun-types": "1.4.3",
    "eslint": "^9.37.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.3",
    "rollup-plugin-visualizer": "^6.0.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.45.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/formbody": "^8.0.2",
    "@fastify/http-proxy": "^11.4.4",
    "@fastify/middie": "^9.3.2",
    "@fastify/static": "^9.1.3",
    "@heroicons/react": "^2.2.0",
    "@posthog/react": "^1.9.0",
    "@sun/api": "^0.2.5",
    "@sun/components": "^0.11.10",
    "@sun/events": "^0.1.0",
    "@sun/shared": "^0.2.11",
    "@sun/ssr": "^0.6.0",
    "@sun/utils": "^0.1.6",
    "@testing-library/user-event": "^14.6.1",
    "brotli": "^1.3.3",
    "dotenv": "^16.5.0",
    "fastify": "^5.8.5",
    "lucide-react": "^0.554.0",
    "nostalgist": "^0.21.1",
    "posthog-node": "^5.21.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^15.4.1",
    "react-router-dom": "^6.22.0",
    "sirv": "^3.0.1"
  }
}
